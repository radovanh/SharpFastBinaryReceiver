2 REM SXRECV1600 v1 MIT - binary receiver for PC-1600, SXBIN at &C0C5
3 REM first: NEW "S0:",&1000 (reserves &C0C5-&CFFF), then load this
9 MAXFILES=1
10 Q=&C0C5:T=PEEK(&F8BF)*256+PEEK(&F8BE)-1:L=Q+385
12 IF T<49152 THEN LET T=57343
15 IF T<L THEN CLS:PRINT "NEW S0: too small":END
20 INIT "COM1:",512:SETCOM "COM1:",9600,8,N,1,N,N
22 CLOSE:OPEN "COM1:" FOR INPUT AS #1
30 IF PEEK(Q+12)<>83 OR PEEK(Q+13)<>88 THEN 60
35 IF PEEK(Q+14)<>49 OR PEEK(Q+15)<>54 THEN 60
38 CLS:PRINT "Checking CRC...";
40 S=0:FOR I=30 TO 384:S=S+PEEK(Q+I):NEXT I
50 IF S=48252 THEN 120
60 CLS:PRINT "Installing SXBIN...";
70 RESTORE:I=Q:S=0
80 READ A:IF A<0 THEN 100
90 POKE I,A:S=S+A:I=I+1:GOTO 80
100 IF S<>49413 OR I-Q<>385 THEN 410
120 POKE Q,9:H=INT(L/256):POKE Q+19,L-256*H:POKE Q+20,H
125 H=INT(T/256):POKE Q+21,T-256*H:POKE Q+22,H
130 CLS:PRINT "SXRECV1600 9600 8N1"
140 CURSOR 0,1:PRINT HEX$(L);"-";HEX$(T);" free"
150 CURSOR 0,2:PRINT "Send .SXE as binary"
160 CURSOR 0,3:PRINT "BREAK=stop";
170 CALL Q+16
175 CLOSE
180 K=PEEK(Q):N=PEEK(Q+6)+256*PEEK(Q+7)
185 A=PEEK(Q+4)+256*PEEK(Q+5):E=PEEK(Q+8)+256*PEEK(Q+9)
190 IF K<>0 THEN 420
200 BEEP 1:CLS:PRINT "OK ";N;" bytes at &";HEX$(A)
210 IF E=65535 THEN END
220 CURSOR 0,1:PRINT "Run &";HEX$(E);" ? (Y/N)";
230 Y$=INKEY$:IF Y$="" THEN 230
240 IF Y$="Y" OR Y$="y" THEN CALL E
250 END
410 CLS:BEEP 1:PRINT "ERR SXBIN DATA damaged"
412 CURSOR 0,1:PRINT I-Q;"/385 ";S;"/49413"
415 END
420 BEEP 1:CLS:PRINT "ERR";K;" ";
430 IF K=2 THEN PRINT "CRC - send again"
440 IF K=3 THEN PRINT "address refused"
450 IF K=4 THEN PRINT "bad header"
460 IF K=6 THEN PRINT "serial error"
470 IF K=7 THEN PRINT "stopped (BRK)"
480 IF K=8 THEN PRINT "timeout"
490 IF K=9 THEN PRINT "SXBIN did not run"
500 R=PEEK(Q+2)+256*PEEK(Q+3)
502 IF K=8 AND R=0 THEN CURSOR 0,1:PRINT "data ok, CRC missing";
504 IF K>5 AND R>0 THEN CURSOR 0,1:PRINT N-R;" of ";N;" bytes";
506 IF K<>2 AND K<>8 THEN 510
507 CURSOR 0,2:FOR I=0 TO 7:PRINT HEX$(PEEK(A+I));" ";:NEXT I
510 END
