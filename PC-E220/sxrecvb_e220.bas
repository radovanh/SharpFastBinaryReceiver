1 REM (c) Radovan Hrebicek 2026
2 REM SXRECVB v1 MIT - binary receiver for PC-E220 bit-bang, SXBIN at 256
3 CLS:WAIT 60
10 Q=256
30 L=PEEK(32766)+256*PEEK(32767)
40 IF L<1024 THEN GOTO 400
50 IF PEEK(Q+12)<>83 OR PEEK(Q+13)<>88 THEN GOTO 60
51 IF PEEK(Q+14)<>66 OR PEEK(Q+15)<>49 OR PEEK(Q+16)<>195 THEN GOTO 60
52 IF PEEK(Q+385)=2 AND PEEK(Q+386)=121 AND PEEK(Q+388)=201 THEN GOTO 120
60 CLS:PRINT "Installing SXBIN...";
70 RESTORE:I=Q:S=0
80 READ V:IF V<0 THEN GOTO 110
90 POKE I,V:S=S+V:I=I+1:GOTO 80
110 READ J,V:IF S<>J OR I<>Q+V THEN GOTO 410
120 CLS:PRINT "SXRECVB 9600 ";Q+389;"-";L-1
150 LOCATE 0,1:PRINT "Send .SXB as binary,"
160 LOCATE 0,2:PRINT "Use 8N2! BRK=stop"
170 CALL Q+16
180 K=PEEK(Q):N=PEEK(Q+6)+256*PEEK(Q+7):A=PEEK(Q+4)+256*PEEK(Q+5):E=PEEK(Q+8)+256*PEEK(Q+9)
190 IF K<>0 THEN GOTO 420
200 BEEP 1:CLS:PRINT "OK ";N;" bytes at ";A
210 IF E=65535 THEN END
220 LOCATE 0,1:PRINT "Run ";E;" ? (Y/N)"
230 Y$=INKEY$:IF Y$="" THEN GOTO 230
240 IF Y$="Y" OR Y$="y" THEN CALL E
250 END
400 CLS:BEEP 1:PRINT "Need MON, USER1FFF"
405 END
410 CLS:BEEP 1:PRINT "ERR SXBIN DATA damaged":LOCATE 0,1:PRINT I-Q;"/";V;" ";S;"/";J
415 END
420 BEEP 1:CLS:PRINT "ERR";K;" ";
430 IF K=2 THEN PRINT "CRC - send again"
440 IF K=3 THEN PRINT "address refused"
450 IF K=4 THEN PRINT "bad header"
460 IF K=6 THEN PRINT "framing - baud?"
470 IF K=7 THEN PRINT "stopped (BRK)"
480 IF K=8 THEN PRINT "timeout"
490 IF K=9 THEN PRINT "SXBIN did not run"
500 L=PEEK(Q+2)+256*PEEK(Q+3):IF K>5 AND L>0 THEN LOCATE 0,1:PRINT N-L;" of ";N;" bytes"
510 END
