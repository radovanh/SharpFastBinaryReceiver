1 REM (c) Radovan Hrebicek 2026
2 REM SXRECVB v1 MIT - binary receiver for PC-G850V, SXBIN at &H100
10 CLEAR:DIM HX$(0)*48
20 B=13:Q=&H100
30 L=PEEK(&H7FFE)+256*PEEK(&H7FFF)
40 IF L<&H400 THEN GOTO 400
50 IF PEEK(Q+12)=83 AND PEEK(Q+13)=88 AND PEEK(Q+14)=66 AND PEEK(Q+15)=49 AND PEEK(Q+16)=195 AND PEEK(Q+417)=8 AND PEEK(Q+418)=195 AND PEEK(Q+420)=2 THEN GOTO 120
60 CLS:PRINT "Installing SXBIN...";
70 RESTORE:I=Q:S=0
80 READ HX$(0):IF HX$(0)="*" THEN GOTO 110
90 FOR J=1 TO LEN(HX$(0)) STEP 2:V=VAL("&H"+MID$(HX$(0),J,2)):POKE I,V:S=S+V:I=I+1:NEXT J:GOTO 80
110 READ J,V:IF S<>J OR I<>Q+V THEN GOTO 410
120 POKE Q+1,B
130 CLS:PRINT "SXRECVB ";:IF B=13 THEN PRINT "9600";
135 IF B=12 THEN PRINT "4800";
140 PRINT " ";HEX$(Q+&H1A5);"-";HEX$(L-1)
150 LOCATE 0,1:PRINT "Send .SXB as binary,"
160 LOCATE 0,2:PRINT "No flow ctl. BRK=stop"
170 CALL Q+16
180 K=PEEK(Q):N=PEEK(Q+6)+256*PEEK(Q+7):A=PEEK(Q+4)+256*PEEK(Q+5):E=PEEK(Q+8)+256*PEEK(Q+9)
190 IF K<>0 THEN GOTO 420
200 BEEP 1:CLS:PRINT "OK ";N;" bytes at &H";HEX$(A)
210 IF E=65535 THEN END
220 LOCATE 0,1:PRINT "Run &H";HEX$(E);" ? (Y/N)"
230 Y$=INKEY$:IF Y$="" THEN GOTO 230
240 IF Y$="Y" OR Y$="y" THEN CALL E
250 END
400 CLS:BEEP 1:PRINT "Need MON, USER1FFF"
405 END
410 CLS:BEEP 1:PRINT "ERR SXBIN DATA damaged":LOCATE 0,1:PRINT I-Q;"/";V;" ";S;"/";J
415 END
420 BEEP 1:CLS:PRINT "ERR";K;" ";
430 IF K=2 THEN PRINT "CRC - send again"
440 IF K=3 THEN PRINT "address refused"
450 IF K=4 THEN PRINT "bad header"
460 IF K=6 THEN PRINT "serial ";PEEK(Q+11);" - baud?"
470 IF K=7 THEN PRINT "stopped (BRK)"
480 IF K=8 THEN PRINT "timeout"
490 IF K=9 THEN PRINT "SXBIN did not run"
500 L=PEEK(Q+2)+256*PEEK(Q+3):IF K>5 AND L>0 THEN LOCATE 0,1:PRINT N-L;" of ";N;" bytes"
510 END
